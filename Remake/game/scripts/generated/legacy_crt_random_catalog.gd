static func next_state(state: int) -> int:
    return int((state * 214013 + 2531011) & UINT32_MASK)


static func random_value(state_after_step: int) -> int:
    return int((state_after_step >> 16) & OUTPUT_MASK)


static func metadata_for_rva(rva: int) -> Dictionary:
    var value: Variant = CALL_SITES.get(rva)
    return (
        (value as Dictionary).duplicate(true)
        if value is Dictionary
        else {}
    )


static func rvas_for_operation(
    semantic_name: String,
    purpose: String,
) -> Array[int]:
    var result: Array[int] = []
    for raw_rva: Variant in CALL_SITES:
        var rva := int(raw_rva)
        var metadata := CALL_SITES[rva] as Dictionary
        if (
            str(metadata.get("semantic_name", "")) == semantic_name
            and str(metadata.get("purpose", "")) == purpose
        ):
            result.append(rva)
    result.sort()
    return result
