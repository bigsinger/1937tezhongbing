{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m1937.example/schemas/campaign.schema.json",
  "title": "M1937 Remake campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "display_name", "levels"],
  "properties": {
    "schema_version": {"const": 1},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "levels": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "number", "title", "level", "mission", "direction"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9._-]{1,64}$"},
          "number": {"type": "integer", "minimum": 1, "maximum": 9999},
          "title": {"type": "string", "minLength": 1, "maxLength": 128},
          "level": {"$ref": "#/$defs/json_path"},
          "mission": {"$ref": "#/$defs/json_path"},
          "direction": {"$ref": "#/$defs/json_path"},
          "terrain": {"type": "string", "maxLength": 512},
          "preview": {"type": "string", "maxLength": 512}
        }
      }
    }
  },
  "$defs": {
    "json_path": {"type": "string", "pattern": "^levels/[a-z0-9._-]{1,64}/[^/]+\\.json$"}
  }
}
