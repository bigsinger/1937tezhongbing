<Window x:Class="Mission1937.MapEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1937 特种兵地图与任务编辑器" Width="1440" Height="900"
        MinWidth="1080" MinHeight="680" Background="#161B22"
        Foreground="#F0EEE6" FontFamily="Microsoft YaHei UI">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#7E201D" Foreground="White">
      <MenuItem Header="文件">
        <MenuItem Header="新建" Click="New_Click" InputGestureText="Ctrl+N" />
        <MenuItem Header="打开工程…" Click="Open_Click" InputGestureText="Ctrl+O" />
        <MenuItem Header="保存" Click="Save_Click" InputGestureText="Ctrl+S" />
        <MenuItem Header="另存为…" Click="SaveAs_Click" />
        <Separator />
        <MenuItem Header="导入原版 VWF…" Click="ImportVwf_Click" />
        <MenuItem Header="导出任务包…" Click="Export_Click" />
        <Separator />
        <MenuItem Header="退出" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="编辑">
        <MenuItem Header="校验地图和任务" Click="Validate_Click" />
        <MenuItem Header="清空当前图层" Click="ClearLayer_Click" />
      </MenuItem>
      <MenuItem Header="帮助">
        <MenuItem Header="操作说明" Click="Help_Click" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom" Background="#202631" Foreground="#D5D8DC">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="就绪" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock x:Name="CoordinateText" Text="格点：—" /></StatusBarItem>
    </StatusBar>

    <ToolBarTray DockPanel.Dock="Top" Background="#202631">
      <ToolBar Background="#202631">
        <Button Content="新建" Click="New_Click" />
        <Button Content="打开" Click="Open_Click" />
        <Button Content="保存" Click="Save_Click" />
        <Separator />
        <TextBlock Text="工具：" VerticalAlignment="Center" Margin="8,0,3,0" />
        <ComboBox x:Name="ToolCombo" Width="150" SelectedIndex="0"
                  SelectionChanged="ToolCombo_SelectionChanged">
          <ComboBoxItem Content="画笔" Tag="paint" />
          <ComboBoxItem Content="橡皮" Tag="erase" />
          <ComboBoxItem Content="放置对象" Tag="object" />
          <ComboBoxItem Content="选择对象" Tag="select" />
        </ComboBox>
        <TextBlock Text="值：" VerticalAlignment="Center" Margin="12,0,3,0" />
        <TextBox x:Name="BrushValueText" Text="1" Width="72" />
        <TextBlock Text="对象：" VerticalAlignment="Center" Margin="12,0,3,0" />
        <ComboBox x:Name="ObjectKindCombo" Width="130" SelectedIndex="0">
          <ComboBoxItem Content="敌军" Tag="enemy" />
          <ComboBoxItem Content="玩家" Tag="player" />
          <ComboBoxItem Content="门" Tag="door" />
          <ComboBoxItem Content="物品" Tag="item" />
          <ComboBoxItem Content="任务点" Tag="objective" />
        </ComboBox>
        <Separator />
        <TextBlock Text="缩放" VerticalAlignment="Center" Margin="8,0,4,0" />
        <Slider x:Name="ZoomSlider" Minimum="0.25" Maximum="3" Value="1"
                TickFrequency="0.25" IsSnapToTickEnabled="True" Width="150"
                ValueChanged="ZoomSlider_ValueChanged" />
      </ToolBar>
    </ToolBarTray>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#202631" Padding="12"
              BorderBrush="#38414D" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="图层" FontSize="16"
                     FontWeight="Bold" Margin="0,0,0,10" />
          <ListBox x:Name="LayerList" Background="#272F3A" Foreground="#F0EEE6"
                   BorderThickness="0" SelectionChanged="LayerList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding Visible}"
                          Foreground="#F0EEE6" Margin="6"
                          Click="LayerVisibility_Click" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="#101419">
        <ScrollViewer x:Name="MapScroll" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="MapScroll_PreviewMouseWheel">
          <local:MapCanvas x:Name="EditorCanvas"
              xmlns:local="clr-namespace:Mission1937.MapEditor.App"
              CellHovered="EditorCanvas_CellHovered"
              CellInvoked="EditorCanvas_CellInvoked"
              ObjectSelected="EditorCanvas_ObjectSelected" />
        </ScrollViewer>
      </Border>

      <TabControl Grid.Column="2" Background="#202631" Foreground="#ECECEC"
                  BorderThickness="1,0,0,0" BorderBrush="#38414D">
        <TabItem Header="关卡">
          <StackPanel Margin="14">
            <TextBlock Text="关卡名称" />
            <TextBox x:Name="MapNameText" Margin="0,5,0,12"
                     TextChanged="MapNameText_TextChanged" />
            <TextBlock Text="尺寸" />
            <TextBlock x:Name="MapSizeText" Margin="0,5,0,16" Foreground="#AEB7C2" />
            <TextBlock TextWrapping="Wrap" Foreground="#AEB7C2"
                       Text="左键使用当前工具；右键擦除。按住 Ctrl 滚轮缩放，普通滚轮平移。原版 VWF 导入为只读解析后的现代工程，不会覆盖原文件。" />
          </StackPanel>
        </TabItem>
        <TabItem Header="对象">
          <DockPanel Margin="12">
            <Button DockPanel.Dock="Bottom" Content="删除所选对象"
                    Click="DeleteObject_Click" Margin="0,8,0,0" />
            <DataGrid x:Name="ObjectGrid" AutoGenerateColumns="False"
                      CanUserAddRows="False" Background="#272F3A"
                      Foreground="#F0EEE6" SelectionChanged="ObjectGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="90" />
                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="45" />
                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="45" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="任务">
          <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="新增任务" Click="AddTask_Click" />
              <Button Content="删除任务" Click="DeleteTask_Click" />
              <Button Content="校验" Click="Validate_Click" />
            </StackPanel>
            <DataGrid x:Name="TaskGrid" AutoGenerateColumns="False"
                      CanUserAddRows="False" Background="#272F3A"
                      Foreground="#F0EEE6">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" />
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="130" />
                <DataGridTextColumn Header="触发器" Binding="{Binding Trigger}" Width="100" />
                <DataGridTextColumn Header="目标对象" Binding="{Binding TargetObjectId}" Width="110" />
                <DataGridTextColumn Header="数量" Binding="{Binding RequiredCount}" Width="55" />
                <DataGridTextColumn Header="后继" Binding="{Binding NextTaskId}" Width="90" />
                <DataGridCheckBoxColumn Header="失败" Binding="{Binding FailureCondition}" Width="50" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
