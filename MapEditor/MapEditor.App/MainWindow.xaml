<Window x:Class="Mission1937.MapEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mission1937.MapEditor.App"
        Title="1937 特种兵地图编辑器" Width="1480" Height="900"
        MinWidth="1120" MinHeight="700"
        Background="#F3F1EA" Foreground="#24272C"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#FCFBF7" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CBC6BA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#9E2F2B" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#24272C" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="#24272C" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#1F2226" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#AAA397" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#1F2226" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#AAA397" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#24272C" />
      <Setter Property="Background" Value="#E8E3D8" />
      <Setter Property="BorderBrush" Value="#AAA397" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#9E2F2B" />
      <Setter Property="BorderBrush" Value="#7E201D" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Foreground" Value="#202328" />
      <Setter Property="Background" Value="White" />
      <Setter Property="RowBackground" Value="White" />
      <Setter Property="AlternatingRowBackground" Value="#F2EFE7" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#DDD8CC" />
      <Setter Property="HeadersVisibility" Value="Column" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Foreground" Value="#24272C" />
      <Setter Property="Background" Value="#E7E2D7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#24272C" />
      <Setter Property="Background" Value="#E7E2D7" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#E4DED1" Foreground="#24272C">
      <MenuItem Header="文件">
        <MenuItem Header="打开地图…" Click="Open_Click"
                  InputGestureText="Ctrl+O" />
        <MenuItem Header="新建空白地图" Click="New_Click"
                  InputGestureText="Ctrl+N" />
        <Separator />
        <MenuItem Header="保存" Click="Save_Click"
                  InputGestureText="Ctrl+S" />
        <MenuItem Header="另存为新地图…" Click="SaveAs_Click" />
        <MenuItem x:Name="NativeVwfSaveMenu"
                  Header="安全另存为原生 VWF…"
                  Click="NativeVwfSaveAs_Click" />
        <MenuItem Header="导出任务包…" Click="Export_Click" />
        <MenuItem Header="新建可运行关卡包向导…"
                  Click="MissionPackageWizard_Click" />
        <Separator />
        <MenuItem Header="退出" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="编辑">
        <MenuItem x:Name="UndoMenu" Header="撤销"
                  Click="Undo_Click" InputGestureText="Ctrl+Z" />
        <MenuItem x:Name="RedoMenu" Header="重做"
                  Click="Redo_Click" InputGestureText="Ctrl+Y" />
        <Separator />
        <MenuItem Header="全选对象" Click="SelectAllObjects_Click"
                  InputGestureText="Ctrl+A" />
        <MenuItem Header="复制所选对象" Click="DuplicateSelected_Click"
                  InputGestureText="Ctrl+D" />
        <MenuItem Header="对齐">
          <MenuItem Header="左对齐" Tag="Left" Click="AlignSelected_Click" />
          <MenuItem Header="水平居中" Tag="HorizontalCenter" Click="AlignSelected_Click" />
          <MenuItem Header="右对齐" Tag="Right" Click="AlignSelected_Click" />
          <MenuItem Header="顶对齐" Tag="Top" Click="AlignSelected_Click" />
          <MenuItem Header="垂直居中" Tag="VerticalCenter" Click="AlignSelected_Click" />
          <MenuItem Header="底对齐" Tag="Bottom" Click="AlignSelected_Click" />
        </MenuItem>
        <MenuItem Header="分布">
          <MenuItem Header="水平均匀分布" Tag="Horizontal"
                    Click="DistributeSelected_Click" />
          <MenuItem Header="垂直均匀分布" Tag="Vertical"
                    Click="DistributeSelected_Click" />
        </MenuItem>
        <MenuItem Header="批量属性…" Click="BatchProperties_Click" />
      </MenuItem>
      <MenuItem Header="地图">
        <MenuItem Header="校验地图和任务" Click="Validate_Click" />
        <MenuItem Header="清空当前图层" Click="ClearLayer_Click" />
        <Separator />
        <MenuItem Header="保存所选区域到素材库…"
                  Click="SaveRegion_Click" />
        <MenuItem Header="从区域素材库粘贴…"
                  Click="PasteRegion_Click" />
        <Separator />
        <MenuItem Header="导出语义差异…"
                  Click="ExportSemanticDiff_Click" />
        <MenuItem Header="三方语义合并…"
                  Click="SemanticMerge_Click" />
        <MenuItem Header="通过插件导入…"
                  Click="PluginImport_Click" />
        <MenuItem Header="通过插件导出…"
                  Click="PluginExport_Click" />
        <Separator />
        <MenuItem Header="一键生成发布资料…"
                  Click="PublishMap_Click" />
      </MenuItem>
      <MenuItem Header="帮助">
        <MenuItem Header="三步使用说明" Click="Help_Click" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="#7E201D" Padding="10,7">
      <DockPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="① 打开原版/工程地图" Click="Open_Click"
                  Style="{StaticResource PrimaryButton}" />
          <Button Content="② 选择素材后点地图放置" IsEnabled="False"
                  Foreground="#5D332F" />
          <Button Content="③ 另存为新地图" Click="SaveAs_Click"
                  Style="{StaticResource PrimaryButton}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                    HorizontalAlignment="Right">
          <CheckBox x:Name="ShowRoutesCheck"
                    Content="显示活物路线"
                    IsChecked="True"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    Checked="PatrolPreview_Changed"
                    Unchecked="PatrolPreview_Changed" />
          <CheckBox x:Name="MotionPreviewCheck"
                    Content="运动预览"
                    IsChecked="True"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    Checked="PatrolPreview_Changed"
                    Unchecked="PatrolPreview_Changed" />
          <CheckBox x:Name="ConnectivityHeatmapCheck"
                    Content="连通热图"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    ToolTip="从所选玩家（或首个玩家）计算可达区域与最短路径；编辑器分析值"
                    Checked="AnalysisPreview_Changed"
                    Unchecked="AnalysisPreview_Changed" />
          <CheckBox x:Name="AiRangesCheck"
                    Content="AI 范围"
                    IsChecked="True"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    ToolTip="选中敌军后显示带遮挡视线、听觉、攻击和警报范围"
                    Checked="AnalysisPreview_Changed"
                    Unchecked="AnalysisPreview_Changed" />
          <TextBlock Text="缩放" Foreground="White"
                     VerticalAlignment="Center" Margin="10,0,4,0" />
          <Slider x:Name="ZoomSlider" Width="150" Minimum="0.1" Maximum="3"
                  Value="0.5" TickFrequency="0.1"
                  ValueChanged="ZoomSlider_ValueChanged" />
          <TextBlock x:Name="ZoomText" Text="50%" Foreground="White"
                     Width="48" VerticalAlignment="Center"
                     TextAlignment="Right" />
        </StackPanel>
      </DockPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="#E3DED3"
               Foreground="#30343A">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="就绪" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="CoordinateText" Text="格点：—" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="AssetStatusText" Text="素材库：正在检查…" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="RouteStatusText" Text="活动路线：—" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="RenderStatusText"
                   Text="局部绘制：—"
                   ToolTip="绿色扇形=视线估算；红=攻击；蓝=听觉；橙=警报" />
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,1,0" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="素材库" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="选一个素材，再在地图上单击即可放置。"
                       Foreground="#5C6066" Margin="0,3,0,10" />
            <TextBox x:Name="AssetSearchText" ToolTip="输入名称筛选素材"
                     TextChanged="AssetFilter_Changed" Margin="0,0,0,7" />
            <ComboBox x:Name="AssetCategoryCombo"
                      SelectionChanged="AssetFilter_Changed"
                      Margin="0,0,0,8" />
          </StackPanel>

          <Expander DockPanel.Dock="Bottom" Header="图层显示"
                    IsExpanded="False" Margin="0,8,0,0">
            <StackPanel>
              <ComboBox x:Name="LayerPresetCombo"
                        SelectionChanged="LayerPreset_SelectionChanged"
                        ToolTip="图层组合预设" Margin="3" />
              <ListBox x:Name="LayerList" Background="White"
                       Foreground="#24272C"
                       SelectionChanged="LayerList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="4">
                      <DockPanel>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding Visible}"
                                  Foreground="#24272C"
                                  PreviewMouseDown="LayerVisibility_PreviewMouseDown"
                                  Click="LayerVisibility_Click" />
                        <CheckBox Content="锁" IsChecked="{Binding Locked}"
                                  DockPanel.Dock="Right" Margin="7,0,0,0"
                                  PreviewMouseDown="LayerVisibility_PreviewMouseDown"
                                  Click="LayerLock_Click" />
                        <Button Content="独显" DockPanel.Dock="Right"
                                Padding="5,1" Margin="5,0,0,0"
                                Tag="{Binding Kind}"
                                Click="LayerSolo_Click" />
                      </DockPanel>
                      <Slider Minimum="0" Maximum="1"
                              Value="{Binding Opacity}"
                              TickFrequency="0.1"
                              PreviewMouseDown="LayerOpacity_PreviewMouseDown"
                              PreviewMouseUp="LayerOpacity_PreviewMouseUp"
                              ValueChanged="LayerOpacity_ValueChanged"
                              ToolTip="图层透明度" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Expander>

          <ListBox x:Name="AssetList" Background="#F3F1EA"
                   BorderBrush="#C9C3B7"
                   SelectionChanged="AssetList_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.CanContentScroll="True"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Margin="3" Padding="5"
                        Background="White" BorderBrush="#D5D0C5"
                        BorderThickness="1" CornerRadius="3">
                  <DockPanel>
                    <Border Width="88" Height="66" Margin="0,0,8,0"
                            Background="#E8E4DA" DockPanel.Dock="Left">
                      <Grid>
                        <Image Source="{Binding ThumbnailPath}"
                               Stretch="Uniform" SnapsToDevicePixels="True" />
                        <TextBlock Text="{Binding IconGlyph}" FontSize="42"
                                   FontWeight="Bold" Foreground="#22262B"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Name}" />
                      <TextBlock Text="{Binding Category}" FontSize="11"
                                 Foreground="#6A6E73" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="#D5D1C8">
        <ScrollViewer x:Name="MapScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="MapScroll_PreviewMouseWheel"
                      ScrollChanged="MapScroll_ScrollChanged"
                      SizeChanged="MapScroll_SizeChanged">
          <local:MapCanvas x:Name="EditorCanvas"
              CellHovered="EditorCanvas_CellHovered"
              CellInvoked="EditorCanvas_CellInvoked"
              ObjectSelected="EditorCanvas_ObjectSelected" />
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1,0,0,0">
        <TabControl x:Name="InspectorTabs"
                    Background="{StaticResource PanelBrush}"
                    Foreground="#24272C">
          <TabItem Header="简单编辑">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="14">
                <TextBlock Text="关卡名称" FontWeight="SemiBold" />
                <TextBox x:Name="MapNameText" Margin="0,5,0,12"
                         TextChanged="MapNameText_TextChanged"
                         GotKeyboardFocus="MapNameText_GotKeyboardFocus"
                         LostKeyboardFocus="MapNameText_LostKeyboardFocus" />
                <TextBlock x:Name="MapSizeText" Foreground="#5E6268"
                           Margin="0,0,0,12" />

                <TextBlock Text="当前操作" FontWeight="SemiBold" />
                <UniformGrid Columns="2" Margin="0,5,0,10">
                  <RadioButton x:Name="PlaceAssetMode"
                               Content="放置素材" Tag="asset"
                               Checked="ToolMode_Checked" Margin="5" />
                  <RadioButton x:Name="SelectMode"
                               Content="仅查看/选择" Tag="select"
                               IsChecked="True"
                               Checked="ToolMode_Checked" Margin="5" />
                  <RadioButton Content="画障碍" Tag="paint"
                               Checked="ToolMode_Checked" Margin="5" />
                  <RadioButton Content="矩形绘制" Tag="rectangle"
                               Checked="ToolMode_Checked" Margin="5" />
                  <RadioButton Content="区域填充" Tag="fill"
                               Checked="ToolMode_Checked" Margin="5" />
                  <RadioButton Content="编辑巡逻点" Tag="patrol"
                               Checked="ToolMode_Checked" Margin="5" />
                  <RadioButton Content="擦除" Tag="erase"
                               Checked="ToolMode_Checked" Margin="5" />
                </UniformGrid>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock Text="画笔半径" VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                  <Slider x:Name="BrushRadiusSlider" Minimum="0" Maximum="8"
                          Value="1" TickFrequency="1" IsSnapToTickEnabled="True"
                          ToolTip="画笔半径（格）" />
                </DockPanel>

                <Border Background="#EEE9DD" BorderBrush="#D1CABC"
                        BorderThickness="1" Padding="10" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="当前素材" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedAssetText"
                               Text="鼠标箭头：仅查看，不放置素材"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <TextBlock Text="提示" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="#555A60"
                            Margin="0,4,0,12"
                            Text="左键执行当前操作；右键擦除。按住 Ctrl 滚轮缩放。Shift+单击地图对象可快速选中。" />

                <TextBlock Text="AI 分析推演" FontWeight="SemiBold" />
                <Grid Margin="0,5,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="AI 等级" FontSize="11" />
                    <ComboBox x:Name="AiLevelCombo"
                              SelectedIndex="2"
                              SelectionChanged="AnalysisProfile_Changed">
                      <ComboBoxItem Content="0 基础" />
                      <ComboBoxItem Content="1 普通" />
                      <ComboBoxItem Content="2 警觉" />
                      <ComboBoxItem Content="3 精锐" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="游戏难度" FontSize="11" />
                    <ComboBox x:Name="DifficultyCombo"
                              SelectedIndex="1"
                              SelectionChanged="AnalysisProfile_Changed">
                      <ComboBoxItem Content="0 休闲" />
                      <ComboBoxItem Content="1 标准" />
                      <ComboBoxItem Content="2 困难" />
                      <ComboBoxItem Content="3 专家" />
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="AnalysisLegendText"
                           TextWrapping="Wrap"
                           Foreground="#555A60"
                           FontSize="11"
                           Margin="0,2,0,12"
                           Text="绿色=带遮挡视线；红=攻击；蓝=听觉；橙=警报。所有近似值均标明来源。" />

                <Button Content="保存为新的地图文件"
                        Click="SaveAs_Click"
                        Style="{StaticResource PrimaryButton}" />
                <Button x:Name="NativeVwfSaveButton"
                        Content="安全另存为可运行 VWF"
                        Click="NativeVwfSaveAs_Click"
                        ToolTip="仅对从原版 VWF 导入的工程可用；不会覆盖源文件" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="对象">
            <DockPanel Margin="10">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox x:Name="ObjectSearchText"
                         ToolTip="搜索名称、ID、类别"
                         TextChanged="ObjectFilter_Changed" />
                <UniformGrid Columns="3" Margin="0,5,0,0">
                  <TextBox x:Name="ObjectSceneFilter"
                           ToolTip="scene 编号"
                           TextChanged="ObjectFilter_Changed" />
                  <TextBox x:Name="ObjectAssetFilter"
                           ToolTip="素材 ID/名称"
                           TextChanged="ObjectFilter_Changed" />
                  <TextBox x:Name="ObjectFactionFilter"
                           ToolTip="阵营"
                           TextChanged="ObjectFilter_Changed" />
                </UniformGrid>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom"
                          Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="复制" Click="DuplicateSelected_Click" />
                <Button Content="批量属性" Click="BatchProperties_Click" />
                <Button Content="删除所选对象"
                        Click="DeleteObject_Click" />
              </StackPanel>
              <DataGrid x:Name="ObjectGrid" AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow"
                        SelectionChanged="ObjectGrid_SelectionChanged"
                        BeginningEdit="Grid_BeginningEdit"
                        CellEditEnding="Grid_CellEditEnding">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="名称"
                                      Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="类别"
                                      Binding="{Binding Category}" Width="88" />
                  <DataGridTextColumn Header="X"
                                      Binding="{Binding X}" Width="42" />
                  <DataGridTextColumn Header="Y"
                                      Binding="{Binding Y}" Width="42" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <TabItem Header="高级任务">
            <DockPanel Margin="10">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="任务 Sidecar 身份"
                           FontWeight="SemiBold" />
                <Grid Margin="0,5,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="48" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="ID" VerticalAlignment="Center"
                             Margin="0,0,5,0" />
                  <TextBox x:Name="SidecarIdText" Grid.Column="1"
                           GotKeyboardFocus="MissionMetadata_GotKeyboardFocus"
                           LostKeyboardFocus="MissionMetadata_LostKeyboardFocus"
                           ToolTip="导出任务 Sidecar 时写入 id" />
                  <TextBlock Grid.Row="1" Text="选择关"
                             VerticalAlignment="Center"
                             Margin="0,4,5,0" />
                  <TextBox x:Name="SelectorLevelText" Grid.Row="1"
                           Grid.Column="1" Margin="0,4,4,0"
                           GotKeyboardFocus="MissionMetadata_GotKeyboardFocus"
                           LostKeyboardFocus="MissionMetadata_LostKeyboardFocus"
                           ToolTip="稳定 MOD 仅支持原版关卡 1–12" />
                  <TextBlock Grid.Row="1" Grid.Column="2"
                             Text="骨架" VerticalAlignment="Center"
                             Margin="2,4,4,0" />
                  <TextBox x:Name="EngineMissionText" Grid.Row="1"
                           Grid.Column="3" Margin="0,4,0,0"
                           GotKeyboardFocus="MissionMetadata_GotKeyboardFocus"
                           LostKeyboardFocus="MissionMetadata_LostKeyboardFocus"
                           ToolTip="原版任务状态机 1–12" />
                </Grid>
                <Button Content="分析任务依赖图与原版状态映射"
                        Click="AnalyzeMissionGraph_Click"
                        Style="{StaticResource PrimaryButton}" />
                <TextBlock x:Name="MissionGraphSummaryText"
                           TextWrapping="Wrap" Foreground="#555A60"
                           Margin="3,3,3,8" />
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom"
                          Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="新增任务" Click="AddTask_Click" />
                <Button Content="删除任务" Click="DeleteTask_Click" />
                <Button Content="校验" Click="Validate_Click" />
              </StackPanel>
              <DataGrid x:Name="TaskGrid" AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        BeginningEdit="Grid_BeginningEdit"
                        CellEditEnding="Grid_CellEditEnding">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ID"
                                      Binding="{Binding Id}" Width="100" />
                  <DataGridTextColumn Header="标题"
                                      Binding="{Binding Title}" Width="120" />
                  <DataGridTextColumn Header="说明"
                                      Binding="{Binding Description}"
                                      Width="180" />
                  <DataGridTextColumn Header="触发器"
                                      Binding="{Binding Trigger}" Width="90" />
                  <DataGridTextColumn Header="目标"
                                      Binding="{Binding TargetObjectId}" Width="90" />
                  <DataGridTextColumn Header="数量"
                                      Binding="{Binding RequiredCount}" Width="48" />
                  <DataGridTextColumn Header="后续"
                                      Binding="{Binding NextTaskId}" Width="80" />
                  <DataGridTextColumn Header="依赖（逗号分隔）"
                                      Binding="{Binding DependsOnText}"
                                      Width="130" />
                  <DataGridCheckBoxColumn Header="可选"
                                          Binding="{Binding Optional}"
                                          Width="48" />
                  <DataGridCheckBoxColumn Header="失败"
                                          Binding="{Binding FailureCondition}"
                                          Width="48" />
                  <DataGridTextColumn Header="失败原因"
                                      Binding="{Binding FailureReason}"
                                      Width="130" />
                  <DataGridTextColumn Header="成功条件"
                                      Binding="{Binding SuccessCondition}"
                                      Width="120" />
                  <DataGridTextColumn Header="撤离条件"
                                      Binding="{Binding EvacuationCondition}"
                                      Width="120" />
                  <DataGridTextColumn Header="原版状态"
                                      Binding="{Binding OriginalStateCode}"
                                      Width="72" />
                  <DataGridTextColumn Header="目标 DB"
                                      Binding="{Binding TargetDatabaseId}"
                                      Width="78" />
                  <DataGridTextColumn Header="主体 DB"
                                      Binding="{Binding SubjectDatabaseId}"
                                      Width="78" />
                  <DataGridTextColumn Header="阵营"
                                      Binding="{Binding SubjectFaction}"
                                      Width="56" />
                  <DataGridTextColumn Header="区域 X"
                                      Binding="{Binding RegionX}"
                                      Width="62" />
                  <DataGridTextColumn Header="区域 Y"
                                      Binding="{Binding RegionY}"
                                      Width="62" />
                  <DataGridTextColumn Header="半径"
                                      Binding="{Binding RegionRadius}"
                                      Width="58" />
                  <DataGridTextColumn Header="期限 ms"
                                      Binding="{Binding DeadlineMilliseconds}"
                                      Width="84" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <TabItem Header="协同设计">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12">
                <TextBlock Text="AI 协同与玩家时间轴"
                           FontWeight="Bold" FontSize="15" />
                <TextBlock TextWrapping="Wrap" Foreground="#555A60"
                           Margin="0,4,0,10"
                           Text="选择敌军后可预演有限增援和最后目击点搜索；玩家时间轴用于和巡逻路线做同步发现分析。所有结果均标记数值来源。" />
                <Button Content="预演所选敌军协同"
                        Click="PreviewAiCoordination_Click" />
                <Button Content="预演 60 秒玩家/巡逻时间轴"
                        Click="PreviewPlayerTimeline_Click" />
                <TextBox x:Name="CollaborationPreviewText"
                         IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="180"
                         VerticalScrollBarVisibility="Auto" />

                <Separator Margin="0,12" />
                <TextBlock Text="巡逻点编辑" FontWeight="Bold" />
                <TextBlock x:Name="PatrolCapacityText"
                           Text="请选择带路线的活物"
                           Foreground="#555A60" Margin="0,4" />
                <ListBox x:Name="PatrolWaypointList"
                         DisplayMemberPath="Label" MinHeight="100"
                         SelectionChanged="PatrolWaypointList_SelectionChanged" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="插入点（随后点地图）"
                          Click="InsertPatrolPoint_Click" />
                  <Button Content="删除所选点"
                          Click="DeletePatrolPoint_Click" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="问题">
            <DockPanel Margin="10">
              <StackPanel DockPanel.Dock="Top">
                <Button Content="重新分析地图质量"
                        Click="RefreshIssues_Click"
                        Style="{StaticResource PrimaryButton}" />
                <TextBlock x:Name="IssueSummaryText"
                           TextWrapping="Wrap"
                           Foreground="#555A60"
                           Margin="3,6,3,10" />
              </StackPanel>
              <DataGrid x:Name="IssueGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        SelectionChanged="IssueGrid_SelectionChanged">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="级别"
                                      Binding="{Binding Severity}"
                                      Width="58" />
                  <DataGridTextColumn Header="位置"
                                      Binding="{Binding Location}"
                                      Width="70" />
                  <DataGridTextColumn Header="问题"
                                      Binding="{Binding Message}"
                                      Width="*" />
                  <DataGridTextColumn Header="数值来源"
                                      Binding="{Binding ValueSource}"
                                      Width="110" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
